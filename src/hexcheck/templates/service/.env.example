# Copia a .env (ignorado por git). Prefijo fijo: __APP_UPPER___
__APP_UPPER___DB_PATH=data/__APP__.db
# Token de escritura: todo endpoint que modifique datos exige `Authorization: Bearer <token>`.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
__APP_UPPER___TOKEN=cambia-esto
# Lo pone el Dockerfile (sha del commit); en local vale "dev".
__APP_UPPER___VERSION=dev
